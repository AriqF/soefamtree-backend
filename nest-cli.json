{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": ["**/*.hbs", "**/*.css", "**/*.html", "**/*.ttf", "**/*.wasm", "**/*.zkey"],
    "watchAssets": true,
    "plugins": ["@nestjs/swagger"]
  }
}
